{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GlacierEQ/Genius-Mastery/schemas/teaching.schema.json",
  "title": "Genius Teaching Contract",
  "type": "object",
  "required": ["schema_version", "teacher", "subject", "method", "verification"],
  "properties": {
    "schema_version": {"type":"integer","const":1},
    "teacher": {"type":"string","minLength":1},
    "subject": {"type":"string","minLength":1},
    "method": {
      "type":"object",
      "required":["explain","demonstrate","reconstruct","transfer"],
      "properties":{
        "explain":{"type":"array","items":{"type":"string"}},
        "demonstrate":{"type":"array","items":{"type":"string"}},
        "reconstruct":{"type":"array","items":{"type":"string"}},
        "transfer":{"type":"array","items":{"type":"string"}}
      },
      "additionalProperties": true
    },
    "learner": {
      "type":"object",
      "properties":{
        "starting_state":{"type":"string"},
        "target_state":{"type":"string"},
        "allowed_support":{"type":"array","items":{"type":"string"}}
      },
      "additionalProperties": true
    },
    "verification": {
      "type":"object",
      "required":["acceptance"],
      "properties":{
        "acceptance":{"type":"array","minItems":1,"items":{"type":"string"}},
        "evidence_refs":{"type":"array","items":{"type":"string"}},
        "transfer_challenges":{"type":"array","items":{"type":"string"}},
        "counterevidence":{"type":"array","items":{"type":"string"}}
      },
      "additionalProperties": true
    },
    "outcome_metrics": {
      "type":"object",
      "properties":{
        "reconstruction_success":{"type":"number","minimum":0,"maximum":1},
        "transfer_success":{"type":"number","minimum":0,"maximum":1},
        "explanation_quality":{"type":"number","minimum":0,"maximum":1},
        "independence":{"type":"number","minimum":0,"maximum":1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}