{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GlacierEQ/Genius-Mastery/schemas/role-brief.schema.json",
  "title": "Genius Role Brief",
  "type": "object",
  "required": ["schema_version", "role", "outcomes"],
  "properties": {
    "schema_version": {"type":"integer","const":1},
    "role": {"type":"string","minLength":1},
    "outcomes": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "archetype": {"type":"string"},
    "constraints": {"type":"array","items":{"type":"string"}},
    "environment": {"type":"array","items":{"type":"string"}},
    "preferred_sources": {"type":"array","items":{"type":"string"}},
    "notes": {"type":"string"}
  },
  "additionalProperties": true
}