{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GlacierEQ/Genius-Mastery/schemas/capability.schema.json",
  "title": "Genius Universal Capability Anatomy",
  "description": "Kernel-up contract for describing what must exist for a capability to become a verified real-world effect.",
  "type": "object",
  "required": ["schema_version", "id", "purpose", "objective", "layers", "verification", "mission_impact"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "purpose": { "type": "string", "minLength": 1 },
    "state": {
      "type": "string",
      "enum": ["aspirational", "mapped", "implemented", "operational", "verified", "degraded", "blocked-scoped"]
    },
    "objective": {
      "type": "object",
      "required": ["desired_reality"],
      "properties": {
        "desired_reality": { "type": "string", "minLength": 1 },
        "current_reality": { "type": "string" },
        "success_conditions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "layers": {
      "type": "object",
      "description": "Vertical excellence stack. Each layer may carry requirements, observed state, evidence, alternatives, failures, and improvement targets.",
      "properties": {
        "reality": { "$ref": "#/$defs/layer" },
        "physical_substrate": { "$ref": "#/$defs/layer" },
        "compute": { "$ref": "#/$defs/layer" },
        "firmware_kernel_os": { "$ref": "#/$defs/layer" },
        "runtime": { "$ref": "#/$defs/layer" },
        "code": { "$ref": "#/$defs/layer" },
        "training_data": { "$ref": "#/$defs/layer" },
        "training_method": { "$ref": "#/$defs/layer" },
        "model": { "$ref": "#/$defs/layer" },
        "model_serving": { "$ref": "#/$defs/layer" },
        "identity_persona": { "$ref": "#/$defs/layer" },
        "agent_kernel": { "$ref": "#/$defs/layer" },
        "instructions": { "$ref": "#/$defs/layer" },
        "context": { "$ref": "#/$defs/layer" },
        "representation": { "$ref": "#/$defs/layer" },
        "memory": { "$ref": "#/$defs/layer" },
        "knowledge": { "$ref": "#/$defs/layer" },
        "perception": { "$ref": "#/$defs/layer" },
        "multimodal": { "$ref": "#/$defs/layer" },
        "language": { "$ref": "#/$defs/layer" },
        "reasoning": { "$ref": "#/$defs/layer" },
        "metacognition": { "$ref": "#/$defs/layer" },
        "planning": { "$ref": "#/$defs/layer" },
        "skills": { "$ref": "#/$defs/layer" },
        "capability_composition": { "$ref": "#/$defs/layer" },
        "tools": { "$ref": "#/$defs/layer" },
        "apis": { "$ref": "#/$defs/layer" },
        "connectors_mcp": { "$ref": "#/$defs/layer" },
        "browser_computer_use": { "$ref": "#/$defs/layer" },
        "files_documents": { "$ref": "#/$defs/layer" },
        "artifact_generation": { "$ref": "#/$defs/layer" },
        "communication": { "$ref": "#/$defs/layer" },
        "state_persistence": { "$ref": "#/$defs/layer" },
        "time_events_automation": { "$ref": "#/$defs/layer" },
        "swarm_multi_agent": { "$ref": "#/$defs/layer" },
        "orchestration": { "$ref": "#/$defs/layer" },
        "observability": { "$ref": "#/$defs/layer" },
        "reliability_recovery": { "$ref": "#/$defs/layer" },
        "security_integrity": { "$ref": "#/$defs/layer" },
        "resource_economics": { "$ref": "#/$defs/layer" },
        "human_interaction": { "$ref": "#/$defs/layer" },
        "domain_expertise": { "$ref": "#/$defs/layer" },
        "real_world_effect": { "$ref": "#/$defs/layer" },
        "learning_evolution": { "$ref": "#/$defs/layer" }
      },
      "additionalProperties": { "$ref": "#/$defs/layer" }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "relationship"],
        "properties": {
          "id": { "type": "string" },
          "relationship": {
            "type": "string",
            "enum": ["requires", "enables", "substitutes", "improves", "conflicts", "produces", "consumes", "verifies", "repairs", "specializes", "composes"]
          },
          "required_for_current_mission": { "type": "boolean" },
          "alternate_routes": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "action": {
      "type": "object",
      "properties": {
        "preconditions": { "type": "array", "items": { "type": "string" } },
        "steps": { "type": "array", "items": { "type": "string" } },
        "expected_effects": { "type": "array", "items": { "type": "string" } },
        "postconditions": { "type": "array", "items": { "type": "string" } },
        "alternate_routes": { "type": "array", "items": { "type": "string" } },
        "failure_modes": { "type": "array", "items": { "type": "string" } },
        "recovery_routes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": ["acceptance"],
      "properties": {
        "acceptance": { "type": "array", "items": { "type": "string" } },
        "tests": { "type": "array", "items": { "type": "string" } },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "independent_readback": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "mission_impact": {
      "type": "object",
      "properties": {
        "mission_relevance": { "$ref": "#/$defs/score" },
        "necessity": { "$ref": "#/$defs/score" },
        "criticality": { "$ref": "#/$defs/score" },
        "sensitivity": { "$ref": "#/$defs/score" },
        "substitutability": { "$ref": "#/$defs/score" },
        "downstream_centrality": { "$ref": "#/$defs/score" },
        "improvement_leverage": { "$ref": "#/$defs/score" },
        "rationale": { "type": "string" }
      },
      "additionalProperties": true
    },
    "evolution": {
      "type": "object",
      "properties": {
        "current_bottleneck": { "type": "string" },
        "improvement_targets": { "type": "array", "items": { "type": "string" } },
        "affected_capabilities": { "type": "array", "items": { "type": "string" } },
        "newly_possible_compositions": { "type": "array", "items": { "type": "string" } },
        "next_frontier": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "layer": {
      "type": "object",
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "available": { "type": "array", "items": { "type": "string" } },
        "missing": { "type": "array", "items": { "type": "string" } },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "alternate_routes": { "type": "array", "items": { "type": "string" } },
        "failure_modes": { "type": "array", "items": { "type": "string" } },
        "improvement_targets": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}