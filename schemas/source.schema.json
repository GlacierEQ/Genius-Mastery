{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GlacierEQ/Genius-Mastery/schemas/source.schema.json",
  "title": "Source registry entry",
  "type": "object",
  "required": ["id", "title", "authority"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "url": { "type": "string" },
    "authority": {
      "type": "string",
      "enum": ["standard", "primary", "research", "university", "reference", "secondary", "community"]
    },
    "publisher": { "type": "string" },
    "domain_tags": { "type": "array", "items": { "type": "string" } },
    "version": { "type": "string" },
    "first_seen": { "type": "string" },
    "last_verified": { "type": "string" },
    "supports_claims": { "type": "array", "items": { "type": "string" } },
    "challenges_claims": { "type": "array", "items": { "type": "string" } },
    "snapshot": {},
    "license_notes": { "type": "string" },
    "trust_notes": { "type": "string" }
  },
  "additionalProperties": true
}
